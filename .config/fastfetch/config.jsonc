{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "padding": { "left": 4, "right": 2, "top": 1 },
    "type": "small",
  },

  "display": {
    "separator": "\u001b[0m ",
    "brightColor": false,
    "color": { "keys": "", "output": "" },
    "percent": {
      "type": 9,
      "color": { "green": "cyan", "yellow": "cyan", "red": "cyan" },
    },
    "size": { "binaryPrefix": "iec", "ndigits": 2 },
    "freq": { "ndigits": 2 },
  },

  "modules": [
    { "type": "break" },
    {
      "type": "title",
      "color": { "user": "yellow", "at": "red", "host": "green" },
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored} {cwd}",
    },
    {
      "type": "os",
      "key": "\u001b[36m  \u001b[34mSystem       ",
      "format": "{pretty-name}",
    },
    {
      "type": "kernel",
      "key": "\u001b[36m  \u001b[34mKernel       ",
      "format": "{sysname} {release} ({arch})",
    },
    {
      "type": "cpu",
      "key": "\u001b[36m  \u001b[34mCPU          ",
      "format": "{name} @ {freq-max}",
    },
    {
      "type": "cpu",
      "key": "\u001b[36m  \u001b[34mTopology     ",
      "format": "{cores-physical} cores ({core-types}), {cores-logical} threads",
    },
    {
      "type": "shell",
      "key": "\u001b[36m  \u001b[34mShell        ",
      "format": "{exe-name}",
    },
    {
      "type": "uptime",
      "key": "\u001b[36m  \u001b[34mUptime       ",
      "format": "{?days}{days} days, {?}{?hours}{hours} hours, {?}{minutes} minutes",
    },
    {
      "type": "wm",
      "key": "\u001b[36m  \u001b[34mDesktop      ",
      "format": "{pretty-name} ({protocol-name})",
    },
    {
      "type": "memory",
      "key": "\u001b[36m󰍛  \u001b[34mMemory       ",
      "format": "{used} / {total} ({percentage})",
    },
    {
      "type": "disk",
      "key": "\u001b[36m󱥎  \u001b[34mStorage (/)  ",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})",
    },
    {
      "type": "custom",
      "key": "\u001b[36m  \u001b[34mColors       ",
      "format": "{#blue}  {#cyan}  {#green}  {#yellow}  {#red}  {#magenta}  {#}",
    },
    { "type": "break" },
  ],
}
