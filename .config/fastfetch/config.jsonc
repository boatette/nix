{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    // "type": "file",
    "source": "/home/boatette/.config/fastfetch/nix.txt",
    "color": {
      "1": "38;2;82;119;195",
      "2": "38;2;127;183;255",
    },
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    "break",
    {
      "key": "  ╭───────────╮",
      "keyColor": "1;1",
      "type": "custom",
    },
    {
      "key": "  {#39}│ {#31}  {#39}user   {#39}│",
      "keyColor": "31;1",
      "outputColor": "31;1",
      "type": "title",
      "format": "{user-name}",
    },
    {
      "key": "  {#39}│ {#33}  {#39}hname  {#39}│",
      "keyColor": "33;1",
      "outputColor": "33;1",
      "type": "title",
      "format": "{host-name}",
    },
    {
      "key": "  {#39}│ {#32}󰻀  {#39}distro {#39}│",
      "keyColor": "32;1",
      "outputColor": "32;1",
      "type": "os",
      "format": "{3}",
    },
    {
      "key": "  {#39}│ {#36}󰌢  {#39}kernel {#39}│",
      "keyColor": "36;1",
      "outputColor": "36;1",
      "type": "kernel",
      "format": "{1} {2}",
    },
    {
      "key": "  {#39}│ {#34}󰅐  {#39}uptime {#39}│",
      "keyColor": "34;1",
      "outputColor": "34;1",
      "type": "uptime",
      "format": "{2}h {3}m",
    },
    {
      "key": "  {#39}│ {#35}  {#39}shell  {#39}│",
      "keyColor": "35;1",
      "outputColor": "35;1",
      "type": "shell",
      "format": "{1}",
    },
    {
      "key": "  {#39}│ {#31}󰏖  {#39}wm/de  {#39}│",
      "keyColor": "31;1",
      "outputColor": "31;1",
      "type": "wm",
      "format": "{0}",
    },
    {
      "key": "  {#39}│ {#33}󰍛  {#39}pkgs   {#39}│",
      "keyColor": "33;1",
      "outputColor": "33;1",
      "type": "packages",
    },
    {
      "key": "  ├───────────┤",
      "keyColor": "1;1",
      "type": "custom",
    },
    {
      "key": "  {#39}│ {#39}  {#39}colors {#39}│",
      "keyColor": "1;1",
      "type": "colors",
      "symbol": "circle",
    },
    {
      "key": "  ╰───────────╯",
      "keyColor": "1;1",
      "type": "custom",
    },
  ],
}
