copy_on_select true
default_layout "compact"
keybinds {
	locked {
		bind "Alt z" {
			MessagePlugin "autolock" {
				payload "disable"
			}
			SwitchToMode "Normal"
		}
	}
	shared {
		bind "Alt Shift z" {
			MessagePlugin "autolock" {
				payload "enable"
			}
		}
	}
}
load_plugins {
	autolock 
}
pane_frames false
plugins {
	autolock location="file:~/.config/zellij/plugins/autolock.wasm" {
		is_enabled true
		print_to_log false
		reaction_seconds "0.3"
		triggers "nvim|vim|fzf|yazi|lazygit|git|less|bat"
	}
}
scroll_buffer_size 50000
serialize_pane_viewport true
show_release_notes false
show_startup_tips false
simplified_ui true
theme "noctalia"
themes {
	terminal {
		bg 0
		black 0
		blue 4
		cyan 6
		fg 7
		green 2
		magenta 5
		orange 3
		red 1
		white 7
		yellow 3
	}
}
ui {
	pane_frames {
		hide_session_name true
		rounded_corners true
	}
}
