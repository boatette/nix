diff --git a/libfprint/drivers/elan.c b/libfprint/drivers/elan.c
index ca02992..2846e6a 100644
--- a/libfprint/drivers/elan.c
+++ b/libfprint/drivers/elan.c
@@ -287,29 +287,75 @@ elan_process_frame_thirds (unsigned short *raw_frame,
   *frames = g_slist_prepend (*frames, frame);
 }
 
+/* submit the frame with the most finger contact as the fingerprint image
+ * these sensors are pressed rather than swiped, so there is no movement to
+ * estimate: assembling the frames gave an image of a different height on every
+ * scan (on a square sensor the forward and reverse error scores come out
+ * near-identical, so the estimation is a coin flip) and nothing matched it
+ * the frame is scaled up because SIFT finds too few keypoints at sensor size
+ */
 static void
 elan_submit_image (FpImageDevice *dev)
 {
   FpiDeviceElan *self = FPI_DEVICE_ELAN (dev);
+
+  g_autoptr(FpImage) frame_img = NULL;
+  g_autoptr(FpImage) img = NULL;
   GSList *raw_frames;
   GSList *frames = NULL;
-  FpImage *img;
+  struct fpi_frame *processed;
+  unsigned int frame_size = self->frame_width * self->frame_height;
+  unsigned short *best = NULL;
+  unsigned int best_sum = 0;
 
   G_DEBUG_HERE ();
 
   raw_frames = g_slist_nth (self->frames, ELAN_SKIP_LAST_FRAMES);
 
+  /* the brightest frame is the one the finger was pressed down hardest for */
+  for (GSList *l = raw_frames; l != NULL; l = l->next)
+    {
+      unsigned short *raw = l->data;
+      unsigned int sum = 0;
+
+      for (unsigned int i = 0; i < frame_size; i++)
+        sum += raw[i];
+
+      if (sum >= best_sum)
+        {
+          best_sum = sum;
+          best = raw;
+        }
+    }
+
+  if (best == NULL)
+    {
+      fp_dbg ("no usable frame in capture");
+      fpi_image_device_retry_scan (dev, FP_DEVICE_RETRY_TOO_SHORT);
+      return;
+    }
+
+  /* process_frame sizes its output from the assembling context even though
+   * nothing is assembled */
   assembling_ctx.frame_width = self->frame_width;
   assembling_ctx.frame_height = self->frame_height;
-  assembling_ctx.image_width = self->frame_width * 3 / 2;
-  g_slist_foreach (raw_frames, (GFunc) self->process_frame, &frames);
-  fpi_do_movement_estimation (&assembling_ctx, frames);
-  img = fpi_assemble_frames (&assembling_ctx, frames);
-  img->flags |= FPI_IMAGE_PARTIAL;
+  assembling_ctx.image_width = self->frame_width;
+
+  self->process_frame (best, &frames);
+  processed = frames->data;
+
+  frame_img = fp_image_new (self->frame_width, self->frame_height);
+  memcpy (frame_img->data, processed->data, frame_size);
 
   g_slist_free_full (frames, g_free);
 
-  fpi_image_device_image_captured (dev, img);
+  img = fpi_image_resize (frame_img, ELAN_IMG_SCALE, ELAN_IMG_SCALE);
+  img->flags |= FPI_IMAGE_PARTIAL;
+
+  fp_dbg ("submitting %ux%u image from best of %u frames",
+          img->width, img->height, self->num_frames);
+
+  fpi_image_device_image_captured (dev, g_steal_pointer (&img));
 }
 
 static void
@@ -842,8 +888,8 @@ activate_run_state (FpiSsm *ssm, FpDevice *dev)
           self->frame_height++;
           self->raw_frame_height = self->frame_height;
         }
-      if (self->frame_height > ELAN_MAX_FRAME_HEIGHT)
-        self->frame_height = ELAN_MAX_FRAME_HEIGHT;
+      /* frames used to be cropped here to improve stitching
+       * nothing is stitched any more, so keep every row the sensor gives us */
       fp_dbg ("sensor dimensions, WxH: %dx%d", self->frame_width,
               self->raw_frame_height);
       fpi_ssm_next_state (ssm);
