{
  "Date": {
    "prefix": "date",
    "description": "ISO date",
    "body": "$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE"
  },
  "Timestamp": {
    "prefix": "stamp",
    "description": "ISO date and time",
    "body": "$CURRENT_YEAR-$CURRENT_MONTH-${CURRENT_DATE}T$CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_SECOND$CURRENT_TIMEZONE_OFFSET"
  },
  "UUID": {
    "prefix": "uuid",
    "description": "Random UUID",
    "body": "$UUID"
  },
  "File name": {
    "prefix": "fname",
    "description": "Name of the current file",
    "body": "$TM_FILENAME"
  },
  "File path": {
    "prefix": "fpath",
    "description": "Path of the current file, relative to the cwd",
    "body": "$RELATIVE_FILEPATH"
  }
}
