#!/usr/bin/env bash

set -euo pipefail

mode=dark
while [ $# -gt 0 ]; do
    case $1 in
    --mode)
        mode=${2:-}
        shift 2
        ;;
    *)
        break
        ;;
    esac
done

wallpaper=${1:-}
if [ -z "$wallpaper" ] || { [ "$mode" != dark ] && [ "$mode" != light ]; }; then
    echo "usage: wallust-palette [--mode dark|light] <image>" >&2
    exit 2
fi

name=${WALLUST_PALETTE_NAME:-Wallust}
dir="${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/palettes"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/wallust-palette"

key=$(printf '%s\0%s\0%s\0%s\0%s\0%s' \
    "$wallpaper" "$(stat -c %Y "$wallpaper")" "$mode" \
    "$WALLUST_BASE" "$WALLUST_TEMPLATE" "$WALLUST_MAP" |
    sha256sum | cut -d' ' -f1)
hit="$cache/$key.json"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

if [ ! -f "$hit" ]; then
    mkdir -p "$work/templates"
    cp "$WALLUST_TEMPLATE" "$work/templates/dump.json"

    cat "$WALLUST_BASE" >"$work/wallust.toml"
    cat >>"$work/wallust.toml" <<EOF
palette = "${mode}16"

[templates]
dump = { template = "dump.json", target = "$work/dump.json" }
EOF

    wallust run \
        --config-dir "$work" \
        --no-cache \
        --skip-sequences \
        --quiet \
        "$wallpaper"

    jq --arg mode "$mode" -f "$WALLUST_MAP" <"$work/dump.json" >"$work/palette.json"

    mkdir -p "$cache"
    install -m 644 "$work/palette.json" "$cache/.$key.json.tmp"
    mv "$cache/.$key.json.tmp" "$hit"

    ls -t "$cache" 2>/dev/null | tail -n +301 | while read -r stale; do
        rm -f "$cache/${stale:?}"
    done
fi

mkdir -p "$dir"
install -m 644 "$hit" "$dir/.$name.json.tmp"
mv "$dir/.$name.json.tmp" "$dir/$name.json"

printf '%s\n' "$name"
