{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/aperture.txt",
    // "source": "~/.config/fastfetch/aperture-inverted.txt",
  },
  "display": {
    "constants": [". "],
    "key": {
      "width": 10,
    },
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{#light_red}@{host-name-colored} {#}{cwd}",
    },
    {
      "type": "os",
      "key": "Distro",
      "keyColor": "cyan",
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "red",
    },
    {
      "type": "wm",
      "key": "Desktop",
      "keyColor": "yellow",
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "blue",
    },
    {
      "type": "disk",
      "key": "OS Age",
      "folders": "/",
      "format": "{create-time:10} [{days} days]",
      "keyColor": "cyan",
    },
    {
      "type": "colors",
      "key": "Colors",
      "symbol": "circle",
      "keyColor": "red",
    },
  ],
}
