{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // "source": "~/.config/fastfetch/aperture.txt",
    "source": "~/.config/fastfetch/aperture-inverted.txt",
    "padding": {
      "top": 0,
      "left": 0,
      "right": 0,
    },
  },
  "display": {
    "separator": ">  ",
    "color": {
      "separator": "red",
    },
    "constants": [
      "───────────────────────────────",
      "│\u001b[31C│\u001b[31D",
      //       ^          ^
      // These numbers must be the length of the 1st constant
    ],
  },
  "modules": [
    {
      "format": "{#1}{#keys}┌{$1}┐\u001b[32D {user-name-colored}{at-symbol-colored}{host-name-colored} ",
      //                                 ^
      // And this one needs to be the length of the 1st constant + 1
      "type": "title",
    },
    {
      "key": "{$2}{#31} kernel   ",
      "type": "kernel",
    },
    {
      "key": "{$2}{#32}󰅐 os age   ",
      "type": "disk",
      "folders": "/",
      "format": "{days} days",
    },
    {
      "key": "{$2}{#33} distro   ",
      "type": "os",
      "format": "{4}",
    },
    {
      "key": "{$2}{#34}󰇄 desktop  ",
      "type": "wm",
      "format": "{1}",
    },
    {
      "key": "{$2}{#36} shell    ",
      "type": "shell",
    },
    {
      "format": "{#1}{#keys}├{$1}┤",
      "type": "custom",
    },
    {
      "key": "{$2}{#39} colors   ",
      "type": "colors",
      "symbol": "circle",
    },
    {
      "format": "{#1}{#keys}└{$1}┘",
      "type": "custom",
    },
  ],
}
