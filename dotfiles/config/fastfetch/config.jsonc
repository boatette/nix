{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/aperture.txt",
    // "source": "~/.config/fastfetch/aperture-inverted.txt",
  },
  "display": {
    "separator": "",
    "key": {
      "width": 11,
    },
  },
  "modules": [
    "break",
    {
      "key": "user",
      "type": "title",
      "format": "{user-name}@{host-name}",
      "keyColor": "31",
    },
    {
      "key": "uptime",
      "type": "uptime",
      "keyColor": "32",
    },
    {
      "key": "distro",
      "type": "os",
      "keyColor": "33",
    },
    {
      "key": "kernel",
      "type": "kernel",
      "keyColor": "34",
    },
    {
      "key": "desktop",
      "type": "de",
      "keyColor": "35",
    },
    {
      "key": "colors",
      "type": "colors",
      "symbol": "circle",
      "keyColor": "39",
    },
  ],
}
