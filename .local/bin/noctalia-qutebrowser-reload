#!/usr/bin/env bash
set -o errexit
set -o nounset
set -o pipefail


hash="$(id -un | tr -d '\n' | md5sum | cut -d' ' -f1)"
socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/qutebrowser/ipc-$hash"
[ -S "$socket" ] || exit 0

printf '%s\n' '{"args": [":config-source"], "target_arg": null, "protocol_version": 1}' \
  | socat -lf /dev/null - UNIX-CONNECT:"$socket"

